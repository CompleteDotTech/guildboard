[
  {
    "name": "Workstream overview",
    "layout": "TABLE_LAYOUT",
    "filter": "",
    "columns": [
      "Title",
      "Assignees",
      "Status",
      "Tier",
      "Priority",
      "Readiness",
      "Parent issue",
      "Sub-issues progress",
      "Labels",
      "Work Type",
      "Research Confidence",
      "Dependency Status",
      "Verification Status",
      "Release Target"
    ]
  },
  {
    "name": "Engineering backlog by priority",
    "layout": "TABLE_LAYOUT",
    "filter": "is:open -status:Done",
    "columns": [
      "Title",
      "Assignees",
      "Priority",
      "Tier",
      "Readiness",
      "Dependency Status",
      "Effort",
      "Work Type",
      "Milestone"
    ]
  },
  {
    "name": "Ready to implement",
    "layout": "TABLE_LAYOUT",
    "filter": "is:open readiness:Ready dependency-status:Unblocked work-type:Task,Subtask status:Backlog,Ready",
    "columns": [
      "Title",
      "Assignees",
      "Priority",
      "Tier",
      "Effort",
      "Work Type",
      "Readiness",
      "Dependency Status",
      "Parent issue"
    ]
  },
  {
    "name": "Blocked or awaiting decision",
    "layout": "TABLE_LAYOUT",
    "filter": "is:open dependency-status:Blocked,\"Awaiting Decision\",\"External Blocker\"",
    "columns": [
      "Title",
      "Assignees",
      "Tier",
      "Priority",
      "Readiness",
      "Dependency Status",
      "Blocking Reason",
      "Parent issue",
      "Owner Role"
    ]
  },
  {
    "name": "Unassigned or missing metadata",
    "layout": "TABLE_LAYOUT",
    "filter": "is:open no:assignee,priority,tier,readiness,work-type,release-target",
    "columns": [
      "Title",
      "Assignees",
      "Tier",
      "Priority",
      "Readiness",
      "Work Type",
      "Release Target",
      "Parent issue",
      "Milestone",
      "Labels"
    ]
  },
